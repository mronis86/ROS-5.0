{
  "appId": "com.sinor.ros.powerpoint-bridge",
  "productName": "ROS PowerPoint Bridge",
  "directories": {
    "output": "dist-openfix",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "renderer/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "electron/ppt-com.ps1",
      "to": "ppt-com.ps1"
    }
  ],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ]
  }
}
