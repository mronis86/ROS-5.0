{
  "name": "ros-offline-kiosk-v2",
  "version": "0.1.0",
  "description": "Offline Kiosk V2 — operator shell for LAN Offline Show, displays, and camera push",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "sync:offline-show": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-offline-show.ps1",
    "sync:weblinked": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-weblinked.ps1",
    "prepare:portable": "node scripts/prepare-portable.js",
    "pack": "npm run prepare:portable && electron-builder --win dir",
    "dist": "npm run prepare:portable && electron-builder --win dir && node scripts/zip-portable-out.js",
    "dist:exe": "npm run prepare:portable && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sinor.ros.offlinekiosk",
    "productName": "ROS Offline Kiosk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engines/offline-show",
        "to": "engines/offline-show",
        "filter": [
          "**/*",
          "!data/**",
          "!**/*.db",
          "!**/*.db-shm",
          "!**/*.db-wal",
          "!ui/node_modules/**",
          "!ui/src/**",
          "!.git/**"
        ]
      },
      {
        "from": "engines/weblinked",
        "to": "engines/weblinked",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      },
      {
        "from": "portable-runtime/node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "launcher/START-PORTABLE.bat",
        "to": "START.bat"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ROS-Offline-Kiosk-Portable-${version}.exe"
    }
  }
}
