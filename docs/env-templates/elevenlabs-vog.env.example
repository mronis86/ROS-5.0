# ElevenLabs VOG (text-to-speech) — set on the Railway ROS-5.0 API service only.
# Never put this in Cloudflare / Vite / client code.
#
# 1. Create an API key in ElevenLabs → Profile → API Keys
# 2. Railway → ROS-5.0 → Variables → add:
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Optional override (default https://api.elevenlabs.io):
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
